&HEAD CHID='flame_periodic', TITLE='Propane burner in a horizontally periodic box: input for the FFT-FD pressure-solver replay' /

! ---------------------------------------------------------------------------------------------
! Mesh. One mesh, so the horizontal directions are periodic over the whole domain.
! 64 x 64 x 64 cells of 3 cm (D*/dx = 10 for the 60 kW fire below).
! Larger alternative (about 4x the cost):  IJK=128,128,64, XB=0.0,3.84,0.0,3.84,0.0,1.92
! and move the burner to XB=1.77,2.07,1.77,2.07,0.0,0.0
! ---------------------------------------------------------------------------------------------
&MESH IJK=64,64,64, XB=0.0,1.92,0.0,1.92,0.0,1.92 /

! Fixed time step, so that the 3D output below is written at consecutive time steps.
! If the run stops with a numerical instability, reduce DT (and the spacing of the RAMP times).
&TIME T_END=6.400, DT=0.002, LOCK_TIME_STEP=.TRUE. /

! ---------------------------------------------------------------------------------------------
! Boundaries: periodic sides, open top, solid floor (default).
! ---------------------------------------------------------------------------------------------
&VENT PBX=0.0,  SURF_ID='PERIODIC' /
&VENT PBX=1.92, SURF_ID='PERIODIC' /
&VENT PBY=0.0,  SURF_ID='PERIODIC' /
&VENT PBY=1.92, SURF_ID='PERIODIC' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! ---------------------------------------------------------------------------------------------
! Fire: 0.30 m x 0.30 m propane burner on the floor, 60 kW (HRRPUA = 60 / 0.09)
! ---------------------------------------------------------------------------------------------
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /
&SURF ID='BURNER', HRRPUA=666.7, COLOR='RED' /
&VENT XB=0.81,1.11,0.81,1.11,0.0,0.0, SURF_ID='BURNER' /

! ---------------------------------------------------------------------------------------------
! Output: cell-centred 3D fields at t = 2 s and 4 s, and at every time step from
! t = 6.0 s to 6.4 s (201 consecutive steps).
! Size: about 1 MB per field and frame, roughly 0.7 GB in total.
! ---------------------------------------------------------------------------------------------
&DUMP RAMP_SL3D='slcf times', DT_SLCF=0.02, DT_HRR=0.1 /

&SLCF XB=0.0,1.92,0.0,1.92,0.0,1.92, QUANTITY='DENSITY',     CELL_CENTERED=.TRUE. /
&SLCF XB=0.0,1.92,0.0,1.92,0.0,1.92, QUANTITY='PRESSURE',    CELL_CENTERED=.TRUE. /
&SLCF XB=0.0,1.92,0.0,1.92,0.0,1.92, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /

! 2D slices for visualization in Smokeview, every 0.02 s (DT_SLCF): planes through the burner
! centre (x = 0.96 m, y = 0.96 m) and a horizontal plane at z = 0.30 m.
&SLCF PBX=0.96, QUANTITY='TEMPERATURE' /
&SLCF PBX=0.96, QUANTITY='DENSITY' /
&SLCF PBX=0.96, QUANTITY='PRESSURE' /
&SLCF PBX=0.96, QUANTITY='H' /
&SLCF PBX=0.96, QUANTITY='DIVERGENCE' /
&SLCF PBX=0.96, QUANTITY='HRRPUV' /
&SLCF PBX=0.96, QUANTITY='VELOCITY', VECTOR=.TRUE. /
&SLCF PBY=0.96, QUANTITY='TEMPERATURE' /
&SLCF PBY=0.96, QUANTITY='DENSITY' /
&SLCF PBY=0.96, QUANTITY='PRESSURE' /
&SLCF PBY=0.96, QUANTITY='H' /
&SLCF PBY=0.96, QUANTITY='DIVERGENCE' /
&SLCF PBY=0.96, QUANTITY='HRRPUV' /
&SLCF PBY=0.96, QUANTITY='VELOCITY', VECTOR=.TRUE. /
&SLCF PBZ=0.30, QUANTITY='TEMPERATURE' /
&SLCF PBZ=0.30, QUANTITY='DENSITY' /
&SLCF PBZ=0.30, QUANTITY='PRESSURE' /
&SLCF PBZ=0.30, QUANTITY='H' /
&SLCF PBZ=0.30, QUANTITY='DIVERGENCE' /
&SLCF PBZ=0.30, QUANTITY='HRRPUV' /
&SLCF PBZ=0.30, QUANTITY='VELOCITY', VECTOR=.TRUE. /

&RAMP ID='slcf times', T=2.000 /
&RAMP ID='slcf times', T=4.000 /
&RAMP ID='slcf times', T=6.000 /
&RAMP ID='slcf times', T=6.002 /
&RAMP ID='slcf times', T=6.004 /
&RAMP ID='slcf times', T=6.006 /
